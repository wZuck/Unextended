5ab8-9e14-c24fd96f8669))(text "SW1/SW2 are 2.54mm solder-hole harnesses. No external 5V connection to U1 BATTERY+." (at 20 45 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid e1574f7e-23e4-5f9f-93c8-f18793670b1d))(text "EC electrodes: logical row = physical row; column = floor(x_u + width_u/2), including empty column bins." (at 20 355 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid 54c8eebb-507c-5de0-b31b-360b945baf12)))
